{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "hkg1"
  ],
  "rewrites": [
    {
      "source": "/i/:code",
      "destination": "/api/item-link/:code"
    },
    {
      "source": "/I/:code",
      "destination": "/api/item-link/:code"
    },
    {
      "source": "/c/:code",
      "destination": "/api/ctn-link/:code"
    },
    {
      "source": "/C/:code",
      "destination": "/api/ctn-link/:code"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/home.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/join.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/flyer-a4.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/home.html",
      "statusCode": 307
    }
  ]
}
